[sub_resource type="Shader" id="Shader_xmxvo"]
code = "shader_type spatial;

uniform sampler2D noise3 : filter_nearest;
uniform sampler2D noise2 : filter_nearest;
uniform sampler2D noise : filter_nearest;

void vertex() {
	// Called for every vertex the material is visible on.
}

void fragment() {
	float n1 = texture(noise, UV).r;
	float n2 = texture(noise2, UV).g;
	float n3 = texture(noise3, UV).b;
	ALBEDO = vec3(0);
	if (n1 > 0.5 && n3 > 0.5) {
		ALBEDO = vec3(0,1,0);
	} else if (n1 > 0.5 && n3 < 0.5) {
		ALBEDO = normalize(vec3(0,1,1));
	} else if (n1 < 0.5 && n2 < 0.5) {
		ALBEDO = normalize(vec3(1,1,0));
	} else if (n1 < 0.5 && n3 > 0.5) {
		ALBEDO = vec3(0,0,1);
	}
}"

